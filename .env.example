# 推荐运行 npm run setup 自动生成口令及密钥；这里不包含旧站密钥。
TEAM_PASSCODE=replace-with-a-long-team-passcode
REVIEW_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=data/review.sqlite
TRUST_PROXY=0
PORT=3000
# 构建时可指定组织内可访问的镜像及 npm 镜像；运行时不访问它们。
NODE_IMAGE=node:24-bookworm-slim
NPM_REGISTRY=https://registry.npmjs.org

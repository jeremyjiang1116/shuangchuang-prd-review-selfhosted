    "edits": [
      {
        "block_id": "M05-02-detail",
        "text": "提供引导问答（痛点来源、目标用户、解决方案、验证方式）、产出物模板（用户痛点访谈纪要、选题评估表、可行性自测）与产出物提交。早期文档的选题与技术商业可行性分析并入此处。",
        "version": 1,
        "author_id": "61939174-45a0-4990-90ef-f44fc04ed5bb",
        "updated_at": "2026-09-11T08:58:39.515Z"
      },
      {
        "block_id": "M05-02-rule",
        "text": "产出物落项目文件夹并绑定版本；未达产出物标准不推进 L3（与阶段推进的衔接口径待确认）；引导问答可跳过、不可自定义、产出物模板按赛道（创意组/创业组/红旅）区分。",
        "version": 1,
        "author_id": "61939174-45a0-4990-90ef-f44fc04ed5bb",
        "updated_at": "2026-09-11T08:59:37.284Z"
      },
      {
        "block_id": "M07-03-detail",
        "text": "表单包含文件名、目标目录、资产标签（比如 BP，路演 PPT）、说明，支持 Word、PPT、Excel、PDF、代码等类型。",
        "version": 1,
        "author_id": "9ce99fc8-537d-443b-8f43-228601d95349",
        "updated_at": "2026-09-11T08:40:17.077Z"
      },
      {
        "block_id": "M09-01-detail",
        "text": "选择项目后显示短板标签，推荐前三位专家并呈现匹配度、领域、战绩等信息。",
        "version": 2,
        "author_id": "6bac2270-81be-472e-8f4a-8f3dbc7313b5",
        "updated_at": "2026-09-11T08:00:17.404Z"
      },
      {
        "block_id": "M14-02-detail",
        "text": "录入名称、分类、受众和职能简介，创建后进入库内文件管理；",
        "version": 1,
        "author_id": "e79b244a-db91-473e-a6d1-4a12a4d0563f",

        "anchors": "[{\"blockId\":\"M03-07-detail\",\"start\":5,\"end\":29,\"quote\":\"章节速诊、创新壁垒自测、一次生成五道质询题等结果\",\"prefix\":\"会话内呈现\",\"suffix\":\"；可切换考官、复制问题并升级完整流程。\",\"version\":0}]",
